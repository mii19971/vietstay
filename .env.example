# Sao chép thành .env.local rồi sửa địa chỉ VietStay API.
# - Web / iOS simulator trên cùng máy:  http://localhost:5045
# - Android emulator:                   http://10.0.2.2:5045
# - Điện thoại thật (Expo Go):          http://<IP-LAN-của-máy-chạy-API>:5045
#   (API phải lắng nghe trên IP đó, vd. ASPNETCORE_URLS=http://0.0.0.0:5045, và mở firewall cổng 5045)
EXPO_PUBLIC_API_URL=https://localhost:44338
